*.test
*.out
coverage.html
/coverage/

# Docs (internal planning docs)
/docs/
PLAN.md

# Claude Code local agent files
.claude/

# Logs
*.log

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local config / secrets — HIRDMAN_* settings live in ~/.config/private/hirdman.env
