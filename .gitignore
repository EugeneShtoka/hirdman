*.local.yaml
*.local.toml

# Local runtime state that must never be committed (secrets / personal data)
*.db
*.sqlite
*.sqlite3
*.sqlite-*
*.db-wal
*.db-shm
cookies.txt
*.cookies
*.pem
*.key
*.crt
*.p12
.env
.env.*

# Pinned tools installed by scripts/ensure-tools.sh (tools/versions.env)
/.tools/
