# The tools CI and `make check` run that go.mod cannot pin, one version each, read by
# scripts/ensure-tools.sh and scripts/pinned-tools.sh (source). The Go toolchain is
# go.mod's `toolchain` line, and golangci-lint and govulncheck are go.mod tools. markdownlint-cli2 is locked by
# tools/markdownlint/package-lock.json.
#
# Plain NAME=value lines only. A bump changes the
# version and every checksum (scripts/pinned-tools.sh reports what is behind; the
# checksums come from each release's own checksum file).

GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256_linux_amd64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
GITLEAKS_SHA256_linux_arm64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
GITLEAKS_SHA256_darwin_amd64=dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709
GITLEAKS_SHA256_darwin_arm64=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5

